VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SITE_URL=https://your-app.vercel.app
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# scripts/migrate.mjs (service role — never commit real key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Google Calendar webhook (Edge Function google-calendar-webhook — set in Supabase secrets)
GOOGLE_CALENDAR_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/google-calendar-webhook

ACCESS_KEY_PEPPER=generate-a-long-random-secret
RECOVERY_CODE_PEPPER=generate-a-long-random-secret
CRON_SECRET=generate-a-long-random-secret
CRM_VERSION_CODE=v2
SITE_URL=https://your-app.vercel.app
# Required in production (non-empty). Empty hosted list → Edge CORS 503 allowed_origins_not_configured (S38/L12).
ALLOWED_ORIGINS=https://your-app.vercel.app,http://127.0.0.1:3000,http://127.0.0.1:3001
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
CRM_VERSION_CODE=v2
SITE_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app,http://127.0.0.1:3000,http://127.0.0.1:3001
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=TangoDB <noreply@your-domain.com>
DEV_CONSOLE_ALLOWLIST=developer@example.com
# Edge submit-purchase-request (S40/L1). Fallback: platform_payment_methods.config.contacts.email
DEVELOPER_NOTIFY_EMAIL=developer@example.com
# Local/staging only — omit or set false in production (S7 / S38 L2)
ACTIVATION_DEBUG=false
